# Publish only explicitly reviewed offline research. Everything else stays local.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/CONTRIBUTING.md
!/docs/
/docs/*
!/docs/RESEARCH.md
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/research-finding.yml
!/.github/ISSUE_TEMPLATE/correction.yml
!/.github/ISSUE_TEMPLATE/config.yml
!/scripts/
/scripts/*
!/scripts/fw_inspect.py
!/scripts/ex_inspect.py
!/scripts/analyze_bitrate.py
!/scripts/analyze_ptp.py
!/scripts/analyze_service_recovery.py
!/scripts/analyze_config_read.py
!/scripts/analyze_ex_service.py
!/scripts/analyze_ex_peripherals.py
!/scripts/recover_and_extract.py
!/scripts/compare_versions.py
!/work/
/work/*
!/work/vendor/
/work/vendor/*
!/work/vendor/sources.json
!/work/analysis/
/work/analysis/*
!/work/analysis/bitrate_analysis.json
!/work/analysis/ptp_research.json
!/work/analysis/version_comparison.json
!/work/analysis/modules.json
!/work/analysis/service_recovery.json
!/work/analysis/config_read.json
!/work/analysis/ex_service.json
!/work/analysis/ex_peripherals.json

# Defense in depth: originals, keys, device snapshots and environments.
*.bin
*.exe
*.dmg
*.zip
*.pyc
__pycache__/
.venv/
key.json
camera_*
.DS_Store
.env*
